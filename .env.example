# ---------------------------------------------------------------------------
# Meal Planner — configuration
#
# Invariant I8: no technical dependency is ever hardcoded. Everything the app
# needs to reach the outside world is declared here.
#
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev

# --- Public entry point -----------------------------------------------------
# Single origin: `/` is served by Next.js, `/api` by FastAPI (see Caddyfile).
# This is also the base used to build the OAuth redirect URI.
APP_BASE_URL=http://localhost:8080

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=change-me-in-dev-too
POSTGRES_DB=mealplanner

# DATABASE_URL is deliberately NOT set here. docker-compose.yml builds it from
# the three variables above so the API and Postgres can never disagree about the
# credentials. Set it only when running the API or Alembic from the host,
# outside Docker:
#   export DATABASE_URL=postgresql+psycopg://mealplanner:...@localhost:5432/mealplanner

# --- Session ----------------------------------------------------------------
# Signed HttpOnly cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=generate-me
SESSION_COOKIE_NAME=mp_session
SESSION_MAX_AGE_SECONDS=2592000

# --- Google OAuth -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI must be exactly: ${APP_BASE_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM --------------------------------------------------------------------
# One of: ollama | anthropic | fake
LLM_PROVIDER=ollama
LLM_MAX_ATTEMPTS=3

# Ollama runs on the HOST, not in a container (see docs/ARCHITECTURE.md §7.3).
# From inside Docker on Linux, the host is reachable via host.docker.internal
# thanks to the extra_hosts entry in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Frontend ---------------------------------------------------------------
# Server Components reach the API container directly; the browser only ever
# talks to /api on the single public origin.
INTERNAL_API_BASE_URL=http://api:8000
