# ---------------------------------------------------------------------------
# Meal Planner — configuration
#
# Invariant I8: no technical dependency is ever hardcoded. Everything the app
# needs to reach the outside world is declared here.
#
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev

# --- Public entry point -----------------------------------------------------
# Single origin: `/` is served by Next.js, `/api` by FastAPI (see Caddyfile).
# This is also the base used to build the OAuth redirect URI.
APP_BASE_URL=http://localhost:8080

# --- Database ---------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
#
# LEFT EMPTY ON PURPOSE, and Postgres refuses to start without it. A template
# that ships something password-SHAPED gets copied and kept — which is exactly
# what happened here, and the value was public in this very file for anyone to
# read. An empty value fails loudly on the first `docker compose up`; a
# plausible one fails silently for months.
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=
POSTGRES_DB=mealplanner

# Special characters are fine, including `!`, `%`, `&` and `*`. They used not to
# be: those four are YAML indicators, Compose's ${...} interpolation altered
# them, `%` broke URL parsing, and Alembic's ConfigParser choked on the
# percent-encoding that fixed it. The credentials now reach the process
# untouched through `env_file`, and app/config.py assembles the URL.
#
# DATABASE_URL is deliberately NOT set here: it is built from the three
# variables above, so the API and Postgres can never disagree. Set it only for a
# hosted database that hands out a connection string and no parts, or to run
# Alembic from the host:
#   export DATABASE_URL=postgresql+psycopg://mealplanner:...@localhost:5432/mealplanner

# --- Session ----------------------------------------------------------------
# Signed HttpOnly cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=mp_session
SESSION_MAX_AGE_SECONDS=2592000

# --- Google OAuth -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI must be exactly: ${APP_BASE_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM --------------------------------------------------------------------
# One of: ollama | anthropic | fake
LLM_PROVIDER=ollama
LLM_MAX_ATTEMPTS=3

# Ollama runs on the HOST, untouched, still listening only on 127.0.0.1. The
# `llm` service in docker-compose.yml relays the Docker bridge to it, so nothing
# is exposed beyond the bridge — which is not routable from the local network.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# A whole week on the 8B is minutes, not seconds. Too low and the failure reads
# as "ollama unreachable", which sends you hunting for a network problem.
OLLAMA_TIMEOUT_SECONDS=600

# Address of the Docker bridge the relay binds to. Check with:
#   ip -4 addr show docker0
DOCKER_BRIDGE_IP=172.17.0.1

# How long a whole-week generation is expected to take, in seconds. Every wait
# threshold in the interface derives from it: the playful register is dropped at
# twice this, and the polling gives up at three times it. Measured at ~30 s on
# the cloud model and 182 s on qwen3:8b locally — a factor of six, which is why
# no threshold is written in the code.
GENERATION_EXPECTED_SECONDS=180

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Frontend ---------------------------------------------------------------
# Server Components reach the API container directly; the browser only ever
# talks to /api on the single public origin.
INTERNAL_API_BASE_URL=http://api:8000

# ---------------------------------------------------------------------------
# Catalogue (phase 1)
# ---------------------------------------------------------------------------
# Where the mounted whitelist lands inside the `catalog` container. The file
# itself is NOT in the repository — copy backend/sources.example.yaml to
# ./sources.yaml (gitignored) and fill it in. docs/ARCHITECTURE.md §11.5.
CATALOG_SOURCES_PATH=/config/sources.yaml
